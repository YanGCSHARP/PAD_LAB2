# Copy to .env and adjust. Every value has a safe default for local development in docker-compose.yml.
LOG_LEVEL=INFO
ENVIRONMENT=dev

RABBITMQ_USER=ticketing
RABBITMQ_PASSWORD=ticketing

AUTH_DB_PASSWORD=auth
USER_DB_PASSWORD=users
CATALOG_DB_PASSWORD=catalog
BOOKING_DB_PASSWORD=booking
PAYMENT_DB_PASSWORD=payment

# Bootstrap administrator created by auth-service on first start
ADMIN_EMAIL=admin@ticketing.io
ADMIN_PASSWORD=Admin12345
ACCESS_TOKEN_TTL_SECONDS=900

# Catalog demo data
SEED_DEMO_DATA=true

# Payment simulator: bookings above this amount are declined (demonstrates saga compensation)
DECLINE_ABOVE_AMOUNT=10000
PROVIDER_LATENCY_MS=500

# Gateway
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=20

GRAFANA_PASSWORD=admin
